DATABASE_URL=postgresql+asyncpg://jobscout:jobscout@db:5432/jobscout

# Groq API key (https://console.groq.com)
API_KEY=gsk_your_groq_api_key_here

# LangSmith tracing (https://smith.langchain.com) — optional
LANGSMITH_API_KEY=lsv2_your_langsmith_api_key_here
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=jobscout

# Gmail SMTP (use an App Password, not your account password)
SMTP_EMAIL=you@gmail.com
SMTP_PASSWORD=your_gmail_app_password

# Email address to receive job alerts
ALERT_EMAIL=you@gmail.com

# Google Sheets (https://sheets.google.com)
GOOGLE_SHEET_ID=your_google_sheet_id_here

# Path to your Google service account credentials JSON file
GOOGLE_CREDENTIALS_PATH=google_credentials.json

# Discord webhook URL for application-ready notifications (optional)
DISCORD_WEBHOOK_URL=

# Sentry DSN (https://sentry.io) — optional, error tracking disabled if unset
SENTRY_DSN=

# development | staging | production
ENVIRONMENT=development

# Python logging level
LOG_LEVEL=INFO

# ATS job source (Greenhouse/Lever) — comma-separated board/company slugs.
ATS_GREENHOUSE_BOARDS=gitlab,asana,discord
ATS_LEVER_COMPANIES=palantir
